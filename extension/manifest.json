{
  "manifest_version": 3,
  "name": "JobPilot Assistant",
  "version": "0.9.25",
  "description": "Autofill job forms (Google/MS Forms, ATS) and save listings to your JobPilot tracker. You always review & submit.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "sidePanel",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "https://project-auto-apply.vercel.app/*",
    "https://35.212.189.37.sslip.io/*",
    "http://localhost:8080/*",
    "https://docs.google.com/*",
    "https://forms.gle/*",
    "https://forms.office.com/*",
    "https://forms.cloud.microsoft/*",
    "https://forms.microsoft.com/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.indeed.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/common/smartFill.js",
        "content/common/fieldEngine.js",
        "content/common/formEngine.js",
        "content/common/fillRunner.js",
        "content/common/assistEngine.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.linkedin.com/jobs/*"
      ],
      "js": [
        "content/sites/linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/*"
      ],
      "js": [
        "content/sites/indeed.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.naukri.com/*"
      ],
      "js": [
        "content/sites/naukri.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
